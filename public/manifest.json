{
  "manifest_version": 3,
  "name": "JumpsCare",
  "version": "1.0",
  "description": "Detects jumpscares",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "https://cybki9m36c.execute-api.eu-north-1.amazonaws.com/*"
  ],
  "icons": {
    "32": "death.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["*://*.netflix.com/*"]
    }
  ]
}
